# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mykouch?retryWrites=true&w=majority

# JWT Secret for Owner Dashboard Authentication
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Environment
NODE_ENV=production
